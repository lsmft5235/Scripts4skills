{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/apple-music-playlist-builder/semantic-enrichment.schema.json",
  "title": "Track Semantic Enrichment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "persistentId",
    "createdAt",
    "model",
    "summary",
    "dimensions",
    "moods",
    "textures",
    "themes",
    "confidence",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "persistentId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valence",
        "energy",
        "tension",
        "warmth",
        "danceability",
        "darkness",
        "experimentalism"
      ],
      "properties": {
        "valence": { "$ref": "#/$defs/score" },
        "energy": { "$ref": "#/$defs/score" },
        "tension": { "$ref": "#/$defs/score" },
        "warmth": { "$ref": "#/$defs/score" },
        "danceability": { "$ref": "#/$defs/score" },
        "darkness": { "$ref": "#/$defs/score" },
        "experimentalism": { "$ref": "#/$defs/score" }
      }
    },
    "moods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/shortDescriptor" }
    },
    "textures": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/shortDescriptor" }
    },
    "themes": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "confidence": { "$ref": "#/$defs/score" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "shortDescriptor": { "type": "string", "minLength": 1, "maxLength": 80 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "accessedAt", "sourceType", "claims"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 200 },
        "accessedAt": { "type": "string", "format": "date-time" },
        "sourceType": {
          "enum": ["review", "interview", "artist", "label", "database", "other"]
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}